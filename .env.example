# BHARAT INTEL QUANTUM - INFRA ENVIRONMENT
PORT=8000

# Core data plane
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASS=password123
KAFKA_SERVERS=localhost:9092
REDIS_URL=redis://redis:6379

# Provider credentials
TWITTER_BEARER_TOKEN=
NEWSAPI_KEY=
OPENWEATHER_API_KEY=
AISSTREAM_API_KEY=
# ELEVATION_API_KEY (Not required: using Open-Elevation free tier)
ELEVATION_API_KEY=
CHAINALYSIS_KEY=
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
TAVILY_API_KEY=

# LLM routing
LLM_ENABLED=true
LLM_ONLY_ON_NEW_EVENTS=true
LLM_CACHE_TTL_SECONDS=3600
LLM_MAX_REQUESTS_PER_DAY=150

# Quota-aware scheduler defaults
NEWSAPI_MAX_PER_DAY=80
NEWSAPI_POLL_SECONDS=1800
OPENWEATHER_MAX_PER_DAY=800
OPENWEATHER_POLL_SECONDS=300
MARITIME_MAX_PER_HOUR=60
MARITIME_POLL_SECONDS=300
AISSTREAM_MAX_VESSELS=20
ELEVATION_BATCH_SIZE=50
ELEVATION_ON_DEMAND_ONLY=true
ELEVATION_LOCATIONS=34.1526,77.5770|Ladakh;34.5553,76.1340|KargilSector
RSS_FEEDS=https://www.dawn.com/rss/latest,https://www.globaltimes.cn/rss
THREAT_KEYWORDS=border,incursion,terror,weapon,vessel
WEATHER_ZONES=34.1526,77.5770|Ladakh;34.5553,76.1340|KargilSector
ACTIVE_ZONE_MULTIPLIER=2
ACTIVE_ALERT_MODE=false
