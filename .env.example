# BHARAT INTEL QUANTUM (BIQ) — .env.example
# Copy to .env and fill in your secrets. NEVER commit .env.

PORT=8000
RUST_LOG=info
REDIS_URL=redis://:your_redis_password@localhost:6379
REDIS_PASSWORD=your_redis_password

# Flights — OpenSky Network
# Anonymous access is quota-limited; authenticated clients use OAuth2.
# Set CLIENT_ID + SECRET only if you register for higher rate limits.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_BBOX=5.0,38.0,65.0,100.0

# Vessels — AISstream
AISSTREAM_API_KEY=
AISSTREAM_BBOXES=[[[5.0,65.0],[38.0,100.0]]]

# Vehicles — GPS provider (YOU PROVIDE)
GPS_API_KEY=
GPS_API_BASE_URL=
GPS_POLL_SECONDS=15

# Weather — OpenWeather
OPENWEATHER_API_KEY=

# Satellite — Copernicus Sentinel Hub
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=

# OSINT — Tavily
TAVILY_API_KEY=
TAVILY_MAX_PER_DAY=33

# Geofence tuning
BORDER_CORRIDOR_KM=15
MARITIME_CORRIDOR_NM=24
QUIET_POLL_SECONDS=45

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/live

# Restrict browser origins; comma-separated URLs without trailing slash
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Separate random tokens for ops access and incoming GPS positions
ADMIN_API_TOKEN=
GPS_WEBHOOK_TOKEN=
# Place names only; not live GPS tracking
GEOAPIFY_API_KEY=
# Disable external ingest for isolated integration tests
INGEST_ENABLED=true
# Optional override if starting outside the backend/repository directory
# BORDER_DATA_DIR=backend/data/borders

# Copernicus Data Space credentials use these endpoints
SENTINEL_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
SENTINEL_PROCESS_URL=https://sh.dataspace.copernicus.eu/api/v1/process
